# Gateway runtime
PORT=8080
ENV=local
UPSTREAM_TIMEOUT=10s

# Upstream services — path prefix and target URL per backend.
# In production these come from a k8s ConfigMap/Secret, not this file.
USER_SERVICE_PREFIX=/api/users
USER_SERVICE_URL=http://localhost:8081

ORDER_SERVICE_PREFIX=/api/orders
ORDER_SERVICE_URL=http://localhost:8082

PRODUCT_SERVICE_PREFIX=/api/products
PRODUCT_SERVICE_URL=http://localhost:8083
